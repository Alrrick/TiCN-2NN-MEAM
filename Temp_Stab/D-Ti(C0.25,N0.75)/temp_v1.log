
#------- INICIALIZACION DE LA SIMULACION -------

units metal         #energia:eV, distancia:A, masa:gr/mol, tiempo:picosec
atom_style charge   #liquidos, solidos, metales
boundary p p p      # p= periodico en x y z

#------- INFORMACION DE LA ESTRUCTURA -------

#archivo con la estructura del cristal
read_data Ti(C0.25,N0.75)_v${i}.data
read_data Ti(C0.25,N0.75)_v1.data
Reading data file ...
  triclinic box = (0 0 0) to (34.105 34.105 34.105) with tilt (0 0 0)
  2 by 2 by 2 MPI processor grid
  reading atoms ...
  4096 atoms
  read_data CPU = 0.006 seconds

mass 1 47.867
mass 2 12.0107
mass 3 14.0067

#------- INTERACCIONES (POTENCIAL INTERATOMICO) -------

pair_style meam/c
pair_coeff * * library.meam Ti C N TiCN.meam Ti C N
Reading MEAM library file library.meam with DATE: 2015-02-12

replicate 1 1 1
Replicating atoms ...
  triclinic box = (0 0 0) to (34.105 34.105 34.105) with tilt (0 0 0)
  2 by 2 by 2 MPI processor grid
  4096 atoms
  replicate CPU = 0.001 seconds

neighbor 2.0 bin
neigh_modify every 20 delay 0 check yes

#------- CALCULOS QUE REALIZARA LAMMPS -------

#**** calcula la energia por atomo
compute eperat all pe/atom
compute 2 all temp
compute 3 all pressure 2
#**** salida apersonalizado de las propiedades del atomo
#__________________________nombre_anim
dump config all custom 100 TiCN.anim id type q x y z fx fy fz c_eperat

#------- EJECUCION -------
#Equilibrio:

timestep 0.001  #paso temporal

thermo 100
thermo_style custom step pe ke temp vol press
thermo_modify lost ignore flush yes

#ensemble de temperatura:

fix 3 all momentum 10 linear 1 1 1 angular rescale

variable a equal (733428+$i*10)
variable a equal (733428+1*10)

velocity all create ${Temper} ${a} mom yes rot yes
velocity all create 1 ${a} mom yes rot yes
velocity all create 1 733438 mom yes rot yes

min_style cg
minimize 1.0e-5 1.0e-7 1000 1000
