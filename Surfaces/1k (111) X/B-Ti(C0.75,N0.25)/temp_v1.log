
#------- INICIALIZACION DE LA SIMULACION -------

units metal         #energia:eV, distancia:A, masa:gr/mol, tiempo:picosec
atom_style charge   #liquidos, solidos, metales
boundary p p p      # p= periodico en x y z

#------- INFORMACION DE LA ESTRUCTURA -------

#archivo con la estructura del cristal
read_data Ti(C0.75,N0.25)_surfX111_v${i}.data
read_data Ti(C0.75,N0.25)_surfX111_v1.data
